{
  "name": "faq-coverage-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered FAQ coverage analysis tool",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces",
    "init-db": "npm run init-db --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "reset-db": "npm run reset-db --workspace=backend",
    "clear-all-questions": "npm run clear-questions --workspace=backend",
    "test": "npm run test --workspace=backend",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces"
  },
  "keywords": [
    "faq",
    "ai",
    "embeddings",
    "vector-search",
    "langchain"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.27.2"
  }
}
